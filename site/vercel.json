{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.dc.html"
    },
    {
      "source": "/cardapio",
      "destination": "/cardapio.dc.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}